datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator nestjsDto {
  provider                        = "prisma-generator-nestjs-dto"
  output                          = "../src/.generated/prisma"
  outputToNestJsResourceStructure = "true"
  flatResourceStructure           = "true"
  exportRelationModifierClasses   = "false"
  reExport                        = "true"
  generateFileTypes               = "all"
  createDtoPrefix                 = "Create"
  updateDtoPrefix                 = "Update"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = ""
  classValidation                 = "true"
  fileNamingStyle                 = "camel"
  noDependencies                  = "false"
  outputType                      = "class"
  prismaClientImportPath          = "@prisma/client"
  definiteAssignmentAssertion     = "false"
  requiredResponseApiProperty     = "true"
  prettier                        = "true"
  outputApiPropertyType           = "true"
}

model User {
  id                           Int                     @id @default(autoincrement())
  name                         String
  /// @IsEmail
  email                        String                  @unique
  password                     String
  is_super_admin               Boolean                 @default(false)
  is_active                    Boolean                 @default(true)
  can_manage_site_settings     Boolean                 @default(false)
  can_manage_news              Boolean                 @default(false)
  documents_access_mode        DocumentsAccessMode     @default(NONE)
  document_groups              DocumentGroup[]         @default([])
  sessions                     Session[]               @relation("UserSessions")
  section_permissions          UserSectionPermission[] @relation("UserSectionPermissions")
  authored_news                News[]                  @relation("NewsAuthor")
  created_documents            Document[]              @relation("DocumentCreatedBy")
  updated_documents            Document[]              @relation("DocumentUpdatedBy")
  created_document_versions    DocumentVersion[]       @relation("DocumentVersionCreatedBy")
  created_document_share_links DocumentShareLink[]     @relation("DocumentShareLinkCreatedBy")
  /// @DtoReadOnly
  created_at                   DateTime                @default(now())
  /// @DtoReadOnly
  updated_at                   DateTime                @updatedAt
  /// @DtoReadOnly
  deleted_at                   DateTime?

  @@map("users")
}

enum DocumentsAccessMode {
  NONE
  ALL
  SELECTED_GROUPS
}

enum DocumentGroup {
  GIA_9
  GIA_11
  GIA
  QUALITY
  REGIONAL
  ABOUT
}

model Session {
  id         Int       @id @default(autoincrement())
  token      String
  user_id    Int
  /// @DtoRelationRequired
  user       User      @relation("UserSessions", fields: [user_id], references: [id])
  expire_at  DateTime?
  /// @DtoReadOnly
  created_at DateTime  @default(now())
  /// @DtoReadOnly
  updated_at DateTime  @updatedAt
  /// @DtoReadOnly
  deleted_at DateTime?

  @@map("sessions")
}

model Section {
  id          Int                     @id @default(autoincrement())
  section_id  String                  @unique
  title       String
  kind        String
  route       String?
  parent_id   Int?
  sort_order  Int                     @default(0)
  is_editable Boolean                 @default(true)
  parent      Section?                @relation("SectionTree", fields: [parent_id], references: [id])
  children    Section[]               @relation("SectionTree")
  permissions UserSectionPermission[] @relation("SectionPermissions")
  /// @DtoReadOnly
  created_at  DateTime                @default(now())
  /// @DtoReadOnly
  updated_at  DateTime                @updatedAt
  /// @DtoReadOnly
  deleted_at  DateTime?

  @@map("sections")
}

model UserSectionPermission {
  id         Int       @id @default(autoincrement())
  user_id    Int
  section_id Int
  user       User      @relation("UserSectionPermissions", fields: [user_id], references: [id])
  section    Section   @relation("SectionPermissions", fields: [section_id], references: [id])
  /// @DtoReadOnly
  created_at DateTime  @default(now())
  /// @DtoReadOnly
  updated_at DateTime  @updatedAt
  /// @DtoReadOnly
  deleted_at DateTime?

  @@unique([user_id, section_id])
  @@map("user_section_permissions")
}

model NewsCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String?
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  news        News[]
  /// @DtoReadOnly
  created_at  DateTime @default(now())
  /// @DtoReadOnly
  updated_at  DateTime @updatedAt

  @@map("news_categories")
}

model News {
  id                   Int               @id @default(autoincrement())
  slug                 String            @unique
  title                String
  excerpt              String
  content              String
  cover_image_url      String?
  cover_media_id       Int?
  published_at         DateTime?
  is_published         Boolean           @default(false)
  publication_status   PublicationStatus @default(DRAFT)
  publish_from         DateTime?
  publish_until        DateTime?
  display_published_at DateTime?
  publication_revision Int               @default(0)
  category_id          Int?
  author_id            Int?
  category             NewsCategory?     @relation(fields: [category_id], references: [id])
  author               User?             @relation("NewsAuthor", fields: [author_id], references: [id])
  cover_media          NewsMedia?        @relation(fields: [cover_media_id], references: [id], onDelete: SetNull)
  /// @DtoReadOnly
  created_at           DateTime          @default(now())
  /// @DtoReadOnly
  updated_at           DateTime          @updatedAt
  /// @DtoReadOnly
  deleted_at           DateTime?

  @@index([is_published, published_at])
  @@index([category_id])
  @@index([author_id])
  @@index([publication_status, publish_from, publish_until, display_published_at])
  @@map("news")
}

enum NewsMediaStatus {
  PENDING
  READY
  QUARANTINED
}

model NewsMedia {
  id             Int             @id @default(autoincrement())
  sha256         String          @unique
  storage_key    String          @unique
  mime_type      String
  extension      String
  size_bytes     BigInt
  source_url     String?
  imported_at    DateTime?
  status         NewsMediaStatus @default(PENDING)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  quarantined_at DateTime?
  news           News[]

  @@map("news_media")
}

model SiteSettings {
  id                  String   @id @default(uuid())
  site_key            String   @unique
  gia_hotline_phone   String
  information_phone   String
  ege_trust_phone     String
  email               String
  home_sections_order String[] @default(["home.quick-access", "home.resources", "home.gia-reference", "home.official-resources"])
  /// @DtoReadOnly
  created_at          DateTime @default(now())
  /// @DtoReadOnly
  updated_at          DateTime @updatedAt

  @@map("site_settings")
}

enum PageSectionType {
  SYSTEM
  CUSTOM_HTML
}

// M9.2 is deliberately additive: PageSection and GlobalHtmlSection remain the
// legacy source of truth until the definition/placement backfill has been
// verified in a deployed environment.
enum SectionDefinitionType {
  PAGE_SYSTEM
  GLOBAL_SYSTEM
  PAGE_CUSTOM_HTML
  GLOBAL_CUSTOM_HTML
}

model PageLayout {
  id         Int           @id @default(autoincrement())
  page_key   String        @unique
  revision   Int           @default(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  sections   PageSection[]
  placements PageSectionPlacement[]

  @@map("page_layouts")
}

model SectionDefinition {
  id                  Int                   @id @default(autoincrement())
  key                 String?               @unique
  type                SectionDefinitionType
  name                String
  description         String?
  system_renderer_key String?
  html                String?
  css                 String?
  javascript          String?
  iframe_height_px    Int?
  owner_page_key      String?
  revision            Int                   @default(1)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  placements          PageSectionPlacement[]

  @@index([type, owner_page_key])
  @@index([system_renderer_key])
  @@map("section_definitions")
}

model PageSectionPlacement {
  id                    Int               @id @default(autoincrement())
  page_layout_id        Int
  page_key              String
  section_definition_id Int
  sort_order            Int
  is_visible            Boolean           @default(true)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  page_layout           PageLayout        @relation(fields: [page_layout_id], references: [id], onDelete: Cascade)
  section_definition    SectionDefinition @relation(fields: [section_definition_id], references: [id], onDelete: Cascade)

  @@unique([page_key, section_definition_id])
  @@index([page_key, sort_order])
  @@index([section_definition_id])
  @@map("page_section_placements")
}

model PageSection {
  id               Int             @id @default(autoincrement())
  page_layout_id   Int
  type             PageSectionType
  system_key       String?
  internal_name    String
  raw_html         String?
  sort_order       Int
  is_enabled       Boolean         @default(true)
  iframe_height_px Int?
  created_by_id    Int?
  updated_by_id    Int?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deleted_at       DateTime?
  page_layout      PageLayout      @relation(fields: [page_layout_id], references: [id], onDelete: Cascade)

  @@index([page_layout_id, is_enabled, sort_order])
  @@index([page_layout_id, sort_order])
  @@map("page_sections")
}

enum GlobalHtmlSlot {
  AFTER_HEADER
  BEFORE_CONTENT
  AFTER_CONTENT
  BEFORE_CONTACTS
  AFTER_CONTACTS
  BEFORE_FOOTER
}

model GlobalHtmlSection {
  id               Int            @id @default(autoincrement())
  key              String         @unique
  name             String
  html             String
  css              String?
  javascript       String?
  iframe_height_px Int            @default(320)
  is_enabled       Boolean        @default(true)
  slot             GlobalHtmlSlot @default(AFTER_CONTENT)
  sort_order       Int            @default(0)
  revision         Int            @default(1)
  created_by_id    Int?
  updated_by_id    Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([is_enabled, slot, sort_order])
  @@index([slot, sort_order])
  @@map("global_html_sections")
}

enum DocumentStatus {
  DRAFT
  UNLISTED
  PUBLISHED
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model StoredFile {
  id          Int               @id @default(autoincrement())
  sha256      String            @unique
  storage_key String            @unique
  extension   String
  mime_type   String
  size_bytes  BigInt
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  versions    DocumentVersion[]

  @@map("stored_files")
}

model Document {
  id                 Int                 @id @default(autoincrement())
  section_key        String
  title              String
  description        String?
  document_number    String?
  document_date      DateTime?
  status             DocumentStatus      @default(DRAFT)
  sort_order         Int                 @default(0)
  current_version_id Int?                @unique
  created_by_id      Int?
  updated_by_id      Int?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  deleted_at         DateTime?
  versions           DocumentVersion[]   @relation("DocumentVersions")
  current_version    DocumentVersion?    @relation("DocumentCurrentVersion", fields: [current_version_id], references: [id], onDelete: Restrict)
  created_by         User?               @relation("DocumentCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  updated_by         User?               @relation("DocumentUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)
  placements         DocumentPlacement[]

  @@index([section_key, status, sort_order])
  @@index([section_key, deleted_at])
  @@map("documents")
}

model DocumentPlacement {
  id                   Int               @id @default(autoincrement())
  document_id          Int
  section_key          String
  sort_order           Int               @default(0)
  publication_status   PublicationStatus @default(DRAFT)
  publish_from         DateTime?
  publish_until        DateTime?
  display_published_at DateTime?
  publication_revision Int               @default(0)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  document             Document          @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, section_key])
  @@index([section_key, sort_order, document_id])
  @@index([section_key, publication_status, publish_from, publish_until, sort_order])
  @@map("document_placements")
}

model DocumentVersion {
  id                Int                 @id @default(autoincrement())
  document_id       Int
  version_number    Int
  storage_key       String
  original_filename String
  extension         String
  mime_type         String
  size_bytes        BigInt
  sha256            String
  stored_file_id    Int?
  created_by_id     Int?
  created_at        DateTime            @default(now())
  document          Document            @relation("DocumentVersions", fields: [document_id], references: [id], onDelete: Restrict)
  current_for       Document?           @relation("DocumentCurrentVersion")
  created_by        User?               @relation("DocumentVersionCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  share_links       DocumentShareLink[] @relation("DocumentVersionShareLinks")
  stored_file       StoredFile?         @relation(fields: [stored_file_id], references: [id], onDelete: SetNull)

  @@unique([document_id, version_number])
  @@unique([document_id, sha256])
  @@index([document_id, created_at])
  @@map("document_versions")
}

model AdminAuthRateLimitBucket {
  key_hash          String    @id
  bucket_type       String
  window_started_at DateTime
  attempts          Int       @default(0)
  blocked_until     DateTime?
  updated_at        DateTime  @updatedAt

  @@index([updated_at])
  @@index([blocked_until])
  @@map("admin_auth_rate_limit_buckets")
}

model DocumentShareLink {
  id                  Int             @id @default(autoincrement())
  document_version_id Int
  token_hash          String          @unique
  token_prefix        String
  expires_at          DateTime?
  revoked_at          DateTime?
  created_by_id       Int?
  created_at          DateTime        @default(now())
  last_access_at      DateTime?
  access_count        Int             @default(0)
  document_version    DocumentVersion @relation("DocumentVersionShareLinks", fields: [document_version_id], references: [id], onDelete: Restrict)
  created_by          User?           @relation("DocumentShareLinkCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([document_version_id])
  @@index([revoked_at, expires_at])
  @@index([created_at])
  @@map("document_share_links")
}
